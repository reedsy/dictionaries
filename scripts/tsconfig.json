{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noEmit": false,
    "skipLibCheck": false
  },
  "include": [
    "**/*.{ts,mts,cts}",
    "vitest.config.ts",
  ]
}
